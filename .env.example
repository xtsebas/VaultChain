# ── Django ────────────────────────────────────────────────────────────────────
DEBUG=1
SECRET_KEY=change-this-to-a-random-50-char-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (used by Django and postgres service) ────────────────────────────
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
POSTGRES_DB=vaultchain_db
POSTGRES_USER=vaultchain_user
POSTGRES_PASSWORD=change-this-password

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL the browser uses to reach the Django API.
# Docker: http://localhost:8000  |  Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000